# .env — SOC Incident Response Platform
# Author: Karishma M — KCG College of Technology
#
# INSTRUCTIONS:
# 1. Copy this file to .env (if not already)
# 2. Set your actual Wazuh API password below
# 3. Never commit .env to version control
#
# If WAZUH_API_PASSWORD is blank, Wazuh integration will show "NOT_CONFIGURED"
# and everything else (simulated incidents, DFIR, PDF) still works.

WAZUH_MANAGER_IP=192.168.31.68
WAZUH_API_PORT=55000
WAZUH_API_USER=wazuh
WAZUH_API_PASSWORD=

# Optional overrides
# DEFAULT_AGENT_NAME=DESKTOP-BJ2IO2A
